rules_version = '2';
// Çip bakiyesi, masalar ve el bilgileri YALNIZCA sunucu (Cloud Functions) tarafından yazılır.
// İstemci sadece kendisine ait olanı okuyabilir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      // Arkadaşlar ve gelen istekler: yalnızca kendisi okur, sunucu yazar
      match /{sub=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /tx/{txId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // Şikâyet kayıtları yalnızca sunucu ve yöneticiler içindir.
    match /reports/{id} {
      allow read, write: if false;
    }
    // Oyuncu şikâyet ve önerileri: yalnızca sunucu yazar, kimse okuyamaz (yönetici konsoldan bakar).
    match /feedback/{id} {
      allow read, write: if false;
    }
    match /feedbackmeta/{uid} {
      allow read, write: if false;
    }
    match /tables/{tableId} {
      // Masanın herkese açık görünümü (ıstakalar hariç): masadaki oyunculara açık
      allow read: if request.auth != null
        && request.auth.uid in resource.data.uids;
      allow write: if false;
      // Her oyuncunun ıstakası yalnızca kendisine açık
      match /hands/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      // Hazır mesajlar ve emojiler: yalnızca masadaki oyuncular okur/yazar; serbest metin yok,
      // yalnızca izin verilen kimlikler (src/online/chat.ts ile aynı liste).
      match /chat/{msgId} {
        // Hazır mesaj ve emoji her masada; serbest yazışma (kind "text") yalnızca sunucudan, VIP odada
        function seated() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/tables/$(tableId)).data.uids;
        }
        allow read: if seated();
        allow create: if seated()
          && request.resource.data.keys().hasOnly(["uid", "kind", "id", "at"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && ((request.resource.data.kind == "msg" && request.resource.data.id in
                ["hello", "goodLuck", "niceWord", "wellPlayed", "thinking", "hurry", "quickPlease", "almost", "oops", "thanks", "gg",
                 "helloCayhane", "helloCarli", "helloFifty", "helloSosyete"])
              || (request.resource.data.kind == "emoji" && request.resource.data.id in
                ["❤️", "👍", "👏", "😂", "😮", "😅", "😢", "😡", "🔥",
                 "👋", "👌", "✌️", "🙏"]));
        allow update, delete: if false;
      }
      // Yazışma hız sınırı ve ihlal sayaçları: yalnızca sunucu
      match /chatmeta/{uid} {
        allow read, write: if false;
      }
      // Sunucunun tam oyun durumu (deste dahil): istemciye kapalı
      match /server/{doc} {
        allow read, write: if false;
      }
    }
  }
}
