# Firebase web uygulaması yapılandırması (Firebase konsolu > Proje ayarları > Uygulamalarınız > Web)
# Bu dosyayı .env.production.local olarak kopyalayıp doldurun. Bu değerler gizli değildir
# (her web uygulamasında görünür); güvenliği Firestore kuralları ve Cloud Functions sağlar.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Yerel geliştirmede emülatör kullanmak için (.env.development.local):
# VITE_FIREBASE_EMULATOR=1
